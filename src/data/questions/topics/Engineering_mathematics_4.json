    "question": {
      "text": "If $\\lambda_1$ and $\\lambda_2$ are the eigenvalues of a $2\\times2$ non-singular matrix $A$, then the eigenvalues of adjoint of $A$ are ______.",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$\\lambda_1$ and $\\lambda_2$"
        },
        {
          "label": "B",
          "text": "$\\lambda_1^2$ and $\\lambda_2^2$"
        },
        {
          "label": "C",
          "text": "$\\lambda_1+\\lambda_2$ and $\\lambda_1-\\lambda_2$"
        },
        {
          "label": "D",
          "text": "$\\lambda_1\\times\\lambda_2$ and $\\dfrac{\\lambda_1}{\\lambda_2}$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "A",
      "correctText": "$\\lambda_1$ and $\\lambda_2$",
      "explanation": "Let $A=\\begin{bmatrix}a&b\\\\c&d\\end{bmatrix}$ be a $2\\times2$ matrix with $\\lambda_1$ and $\\lambda_2$ as its eigenvalues. The characteristic equation of $A$ is $(a-\\lambda)(d-\\lambda)-bc=0$. The adjoint of $A$ is $\\begin{bmatrix}d&-b\\\\-c&a\\end{bmatrix}$, whose characteristic equation is $(d-\\lambda)(a-\\lambda)-bc=0$, the same characteristic equation. Therefore the eigenvalues of adjoint of $A$ are $\\lambda_1$ and $\\lambda_2$. Choice (A).",
      "status": "confirmed"
    },
