    "question": {
      "text": "For a homogeneous system of linear equations $AX=O$ with four equations in four unknowns, if the number of linearly independent solutions is one, then the rank of $A$ is ______.",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$1$"
        },
        {
          "label": "B",
          "text": "$2$"
        },
        {
          "label": "C",
          "text": "$3$"
        },
        {
          "label": "D",
          "text": "$4$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "C",
      "correctText": "$3$",
      "explanation": "The number of linearly independent solutions of a homogeneous system $AX=O$ is $n-r$, where $n$ is the number of unknowns and $r$ is the rank of $A$. Hence $n-r=1$, so $4-r=1$ and $r=3$. The rank of $A=3$. Choice (C).",
      "status": "confirmed"
    },
