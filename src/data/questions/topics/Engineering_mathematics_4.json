    "question": {
      "text": "If $A$ is a square matrix of order 5 with $A^{-1}=A^T$ and non-negative determinant, then the determinant of $A$ is ______.",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$0$"
        },
        {
          "label": "B",
          "text": "$1$"
        },
        {
          "label": "C",
          "text": "$2$"
        },
        {
          "label": "D",
          "text": "$5$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "B",
      "correctText": "$1$",
      "explanation": "Given $A^{-1}=A^T$ and det of $A$ is non-negative. $AA^T=A^TA=I_5$. Taking determinants, $|A|^2=1$, so $|A|=\\pm1$. Since $|A|$ is non-negative, the determinant of $A$ is $1$. Choice (B).",
      "status": "confirmed"
    },
    "classification": {
      "subject": "Engineering Mathematics",
