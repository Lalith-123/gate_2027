    "question": {
      "pdfName": "Engineering_mathematics_2.pdf",
      "text": "If\n\\[\nf(x)=\n\\begin{cases}\n\\dfrac{\\sqrt{x}-3}{x-9},&x\\ne9,\\\\\n3k,&x=9,\n\\end{cases}\n\\]\nis continuous everywhere, then \\(k\\) is equal to ______.",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$\\frac12$"
        },
        {
          "label": "B",
          "text": "$\\frac13$"
        },
        {
          "label": "C",
          "text": "$\\frac19$"
        },
        {
          "label": "D",
          "text": "$\\frac1{18}$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "D",
      "correctText": "$\\frac1{18}$",
      "explanation": "Since \\(f(x)\\) is continuous at \\(x=9\\),\n\\[\n\\lim_{x\\to9}\\frac{\\sqrt{x}-3}{x-9}=3k.\n\\]\nBy L'Hospital's Rule,\n\\[\n\\lim_{x\\to9}\\frac{1}{2\\sqrt{x}}=\\frac16=3k.\n\\]\nTherefore\n\\[\nk=\\frac1{18}.\n\\]\nChoice (D).",
      "status": "confirmed"
    },
