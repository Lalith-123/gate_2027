    "question": {
      "pdfName": "Engineering_mathematics_2.pdf",
      "text": "If\n\\[\nu=\\tan^{-1}\\left(\\frac{x^3-y^3}{x+y}\\right),\n\\]\nthen the value of\n\\[\nx\\frac{\\partial u}{\\partial x}+y\\frac{\\partial u}{\\partial y}\n\\]\nis",
      "type": "MCQ",
      "options": [
