    "question": {
      "pdfName": "Engineering_mathematics_2.pdf",
      "text": "If the function \\(f(x)=(\\sin2x)e^{-2x}\\) satisfies Rolle's theorem in the interval \\(\\left(0,\\frac{\\pi}{2}\\right)\\), then the value of \\(c\\in\\left(0,\\frac{\\pi}{2}\\right)\\) such that \\(f'(c)=0\\) is",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$\\frac{\\pi}{8}$"
        },
        {
          "label": "B",
          "text": "$\\frac{\\pi}{4}$"
        },
        {
          "label": "C",
          "text": "$\\frac{\\pi}{6}$"
        },
        {
          "label": "D",
          "text": "$\\frac{\\pi}{3}$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "A",
      "correctText": "$\\frac{\\pi}{8}$",
      "explanation": "Given \\(f(x)=e^{-2x}\\sin2x\\),\n\\[\nf'(x)=\\sin2x(-2e^{-2x})+2\\cos2x\\,e^{-2x}\n=2e^{-2x}(\\cos2x-\\sin2x).\n\\]\nFor \\(f'(c)=0\\),\n\\[\n\\sin2c=\\cos2c\\Rightarrow\\tan2c=1.\n\\]\nThus\n\\[\nc=\\frac{\\pi}{8}\\in\\left(0,\\frac{\\pi}{2}\\right).\n\\]\nChoice (A).",
      "status": "confirmed"
    },
