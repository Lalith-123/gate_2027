    "question": {
      "pdfName": "Engineering_mathematics_2.pdf",
      "text": "Let \\(f(x)\\) and \\(g(x)\\) be two continuous functions in \\([a,b]\\) and differentiable in \\((a,b)\\) and \\(g'(x)\\ne0\\) for any \\(x\\in(a,b)\\), then there exists at least one value \\(c\\in(a,b)\\), by Cauchy mean value theorem which of the following is true?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$\\displaystyle\\frac{f^2(c)}{g'(c)}=\\frac{f(b)-g(a)}{g(b)+f(a)}$"
        },
        {
          "label": "B",
          "text": "$\\displaystyle\\frac{g'(c)}{f'(c)}=\\frac{f(b)+g(b)}{f(a)+f(b)}$"
        },
        {
          "label": "C",
          "text": "$\\displaystyle\\frac{f'(c)}{g'(c)}=\\frac{f'(b)-f'(a)}{g'(b)-g'(a)}$"
        },
        {
          "label": "D",
          "text": "$\\displaystyle\\frac{f'(c)}{g'(c)}=\\frac{f(b)-f(a)}{g(b)-g(a)}$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "D",
      "correctText": "$\\displaystyle\\frac{f'(c)}{g'(c)}=\\frac{f(b)-f(a)}{g(b)-g(a)}$",
      "explanation": "This is the standard result of Cauchy's mean value theorem. Choice (D).",
      "status": "confirmed"
    },
