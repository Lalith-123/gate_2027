    },
    "question": {
      "pdfName": "Computer_Networks_4.pdf",
      "direction": "Directions for questions 1 to 25: Select the correct alternative from the given choices.",
      "text": "Consider a link with 10 Mbps bandwidth and 16 m sec round trip time, if frame size is 1 K bytes then how much percentage of link capacity is utilized?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "9.5"
        },
        {
          "label": "B",
          "text": "7.8"
        },
        {
          "label": "C",
          "text": "5"
        },
        {
          "label": "D",
          "text": "12"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "C",
      "correctText": "5",
      "explanation": "Throughput = 1 K bytes / 16 m sec\n\n= (1 × 10^3 × 8 bits) / (16 × 10^-3 sec)\n\n= 10^6 / 2 bps\n\n% of link utilization = (10^6 / 2) × 100 / (10 × 10^6)\n\n= (10^6 / (2 × 10 × 10^6)) × 100 = 5%.\n\nChoice (C)",
      "status": "confirmed"
    },
    "classification": {
      "subject": "Computer Networks",
      "topic": "Data link layer / Flow control",
      "subtopic": "Link utilization",
      "tags": []
    },
