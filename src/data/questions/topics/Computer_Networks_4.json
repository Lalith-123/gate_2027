      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "D",
      "correctText": "5 KB",
      "explanation": "When senders utilization is 50% then\nL = BR\nwhere\nL = length of the packet\nB = Band width of link\nR = Round trip time\n\n∴ L = 10 × 10^6 × 4 × 10^-3 bits\n= 10 × 4 × 10^3 bits\n= 40 × 10^3 bits\n= 5 KB. Choice (D)",
      "status": "confirmed"
    },
    "classification": {
