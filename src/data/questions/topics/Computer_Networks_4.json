      "text": "What will be the length of the packet if the senders utilization is 50%, Band width of the link is 10 Mbps and the Round trip time is 4 msec?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "40 KB"
        },
        {
          "label": "B",
          "text": "8 KB"
        },
        {
          "label": "C",
          "text": "6 KB"
        },
