    "question": {
      "text": "Let $S$ be the set of all 4 digit numbers that can be formed using the digits 2, 3, 5, 7, 8 and 9. Probability that a randomly selected number of $S$ has all digits distinct is ______.",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "$\\frac{5}{12}$"
        },
        {
          "label": "B",
          "text": "$\\frac{5}{18}$"
        },
        {
          "label": "C",
          "text": "$\\frac{5}{24}$"
        },
        {
          "label": "D",
          "text": "$\\frac{5}{36}$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "B",
      "correctText": "$\\frac{5}{18}$",
      "explanation": "The number of 4 digit numbers that can be formed using the digits 2, 3, 5, 7, 8 and 9 = the number of elements of $S=6^4$.\nThe number of 4 digit numbers of $S$ that have all digits distinct = the number of 4 digit numbers that can be formed using the digits 2, 3, 5, 7, 8 and 9 = ${}^6P_4$.\nTherefore,\n$$P(\\text{all digits distinct})=\\frac{{}^6P_4}{6^4}=\\frac{5}{18}.$$\nChoice (B)",
      "status": "confirmed"
    },
