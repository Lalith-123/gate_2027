    },
    "question": {
      "pdfName": "Operating_System_5.pdf",
      "direction": "Directions for questions 1 to 25: Select the correct alternative from the given choices.",
      "text": "Consider a system with 128 MB physical memory and a 32-bit virtual address space. If the page size is 2 KB, what is the approximate page table size?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "2 MB"
        },
        {
          "label": "B",
          "text": "4 MB"
        },
        {
          "label": "C",
          "text": "8 MB"
        },
        {
          "label": "D",
          "text": "16 MB"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "B",
      "correctText": "4 MB",
      "explanation": "Number of page = (Virtual memory size)/(Page size)\nNumber of frames = Main Memory size/Page size = 2^27/2^11 = 2^16\nPage Table size = Number of pages * Number of bits to address frame\n= 2^21 * 16 bits\n= 2^21 * 2 B = 4 MB                     Choice (B)",
      "status": "confirmed"
    },
    "classification": {
      "subject": "Operating System",
      "topic": "Paging",
      "subtopic": "page table size",
      "tags": []
