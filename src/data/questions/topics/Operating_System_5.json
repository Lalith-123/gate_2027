    "id": "gate-operating-system-test-1-q001",
    "exam": {
      "name": "GATE",
      "fullName": "Graduate Aptitude Test in Engineering",
      "year": null,
      "session": "Operating System"
    },
    "question": {
      "pdfName": "Operating_System_5.pdf",
      "direction": "Directions for questions 1 to 25: Select the correct alternative from the given choices.",
      "text": "Suppose that, the time to service a page fault is 10 sec on average, memory access time is 1 m sec. If a page fault occurs for every 10000 references, what is the average memory access time?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "1.9999 m sec"
        },
        {
          "label": "B",
          "text": "1 m sec"
        },
        {
          "label": "C",
          "text": "9.999 m sec"
        },
        {
          "label": "D",
          "text": "1.9999 µ sec"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "A",
      "correctText": "1.9999 m sec",
      "explanation": "EAT = H*MAT + (1 – H)*(P.F.T)\nH = 0.9999 (1 page fault for every 10000)\nMAT = 1 m sec\nP.F.T = 10 sec\nEAT = 0.9999 * 1 m sec + (0.0001)* 10 sec.\n= 0.9999 + 1 m sec\n= 1.9999 m sec                            Choice (A)",
      "status": "confirmed"
    },
    "classification": {
      "subject": "Operating System",
      "topic": "Demand paging",
      "subtopic": "effective access time",
      "tags": []
    },
    "source": {
