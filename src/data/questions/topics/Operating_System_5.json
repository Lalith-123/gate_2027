  {
    "id": "gate-operating-system-test-1-q002",
    "exam": {
      "name": "GATE",
      "fullName": "Graduate Aptitude Test in Engineering",
      "year": null,
      "session": "Operating System"
    },
    "question": {
      "pdfName": "Operating_System_5.pdf",
      "direction": "Directions for questions 1 to 25: Select the correct alternative from the given choices.",
      "text": "If an instruction takes ‘n’ micro seconds and page fault takes an additional ‘m’ micro seconds. If the average page fault occurs for every ‘k’ instructions, then effective access time is ____. ",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "(n + m)/k"
        },
        {
          "label": "B",
          "text": "m + n/k"
        },
        {
          "label": "C",
          "text": "n + m/k"
        },
        {
          "label": "D",
          "text": "n + m * k"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "C",
      "correctText": "n + m/k",
      "explanation": "EAT = H * MAT + (1 – H)*(P.F.T + MAT)\n= ((k − 1)/k) × n + (1/k)(m + n)\n= n + m/k                                   Choice (C)",
      "status": "confirmed"
    },
    "classification": {
      "subject": "Operating System",
      "topic": "Demand paging",
      "subtopic": "effective access time",
      "tags": []
    },
