          "text": "$(a+b+c)(\\bar a+\\bar b+c)(a+\\bar b+c)$"
        },
        {
          "label": "D",
          "text": "$(\\bar a+b+c)(\\bar a+\\bar b+c)(a+b+c)(a+\\bar b+c)$"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
