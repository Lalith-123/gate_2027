      "options": [
        {
          "label": "A",
          "text": "$\\Sigma m(1,2,4,7,8,11,13,14)$"
        },
        {
          "label": "B",
          "text": "$\\Sigma m(0,3,5,6,9,10,12,15)$"
        },
        {
          "label": "C",
          "text": "$\\Sigma m(0,1,3,5,8,10,13,15)$"
        },
        {
          "label": "D",
          "text": "$\\Sigma m(1,3,5,7,9,11,13,15)$"
        }
