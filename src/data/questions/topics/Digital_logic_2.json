    "question": {
      "text": "The two numbers represented in signed 2’s complement form are:\n$P=11011101$ and $Q=11100101$, if $Q$ is subtracted from $P$, the value obtained in signed 2’s complement form is?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "11110111"
        },
        {
          "label": "B",
          "text": "11000010"
        },
        {
          "label": "C",
          "text": "11111000"
        },
        {
          "label": "D",
          "text": "00000111"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "C",
      "correctText": "11111000",
      "explanation": "$P=11011101$.\n$00100011$ (by taking 2's complement), so $P=-35$.\n\n$Q=11100101$.\n$00011011$ (by taking 2's complement), so $Q=-27$.\n\n$P-Q=-35-(-27)=-8=1111\\ 1000$ in signed 2's complement form.\nChoice (C).",
      "status": "confirmed"
    },
