          "label": "B",
          "text": "$\\sum x_i y_i=a\\sum x_i+b\\sum x_i^2+c\\sum x_i^3$"
        },
        {
          "label": "C",
          "text": "$\\sum x_i y_i^2=a\\sum x_i^2+b\\sum x_i^3+c\\sum x_i^4$"
        },
        {
          "label": "D",
          "text": "$\\sum x_i^2y_i=a\\sum x_i^2+b\\sum x_i^3+c\\sum x_i^4$"
        }
