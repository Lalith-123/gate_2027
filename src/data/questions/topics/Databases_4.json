    },
    "question": {
      "pdfName": "Databases_4.pdf",
      "direction": "Directions for questions 1 to 25: Select the correct alternative from the given choices.",
      "text": "Consider the given functional dependencies R(A, B, C, D):\nFD = {A → B\nC → B\nD → B}\nThe given Relation is in which Normal Form?",
      "type": "MCQ",
      "options": [
        {
          "label": "A",
          "text": "1 NF"
        },
        {
          "label": "B",
          "text": "2 NF"
        },
        {
          "label": "C",
          "text": "3 NF"
        },
        {
          "label": "D",
          "text": "BCNF"
        }
      ],
      "marks": null,
      "negativeMarks": null,
      "difficulty": null
    },
    "answer": {
      "correctOption": "A",
      "correctText": "1 NF",
      "explanation": "A → B\nC → B\nD → B\n\n(ACD)+ = {ACDB}\nPrime Attributes = ACD\nNon prime Attributes = B\nA → B\n↓ Non prime Attribute\nPartial Key\nIt violates 2NF.\n∴ The Relation is in 1 NF.\nChoice (A)",
      "status": "confirmed",
      "image": "images/Databases_4/databases_4-q009-explanation.png"
    },
    "classification": {
      "subject": "Databases",
      "topic": "Normalization — 2NF",
      "subtopic": null,
      "tags": []
    },
